{
  "name": "stylelint-io",
  "version": "0.0.0",
  "private": true,
  "description": "Stylelint's website",
  "homepage": "https://stylelint.io",
  "repository": "https://github.com/stylelint/stylelint.io.git",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/stylelint"
  },
  "license": "MIT",
  "author": "stylelint",
  "scripts": {
    "build": "npm run gendoc && astro build",
    "format": "prettier . --write",
    "gendoc": "node ./scripts/generate-docs.mjs src/content/docs/",
    "lint": "npm-run-all --parallel lint:*",
    "lint:css": "stylelint \"**/*.css\" --ignore-path .gitignore ",
    "lint:formatting": "prettier . --check",
    "lint:js": "eslint .",
    "lint:md": "remark . --quiet --frail --ignore-path .gitignore",
    "lint:types": "tsc --project scripts",
    "prepare": "git config set --local core.hooksPath .githooks || true",
    "serve": "astro preview",
    "start": "npm run gendoc && astro dev",
    "pretest": "npm run lint",
    "test": "npm run build"
  },
  "lint-staged": {
    "*.css": "stylelint --cache --fix",
    "*.mjs": "eslint --cache --fix",
    "*.{mjs,json,md,yml}": "prettier --write"
  },
  "prettier": "@stylelint/prettier-config",
  "remarkConfig": {
    "plugins": [
      "@stylelint/remark-preset"
    ]
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard",
      "stylelint-config-modern",
      "stylelint-config-alphabetical-order"
    ]
  },
  "dependencies": {
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.4.13"
  },
  "devDependencies": {
    "@stylelint/prettier-config": "^4.1.0",
    "@stylelint/remark-preset": "^6.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.10",
    "awesome-stylelint": "https://github.com/stylelint/awesome-stylelint/tarball/e5a190f23b75fd2c2f9a5c74f0fb5428a7fd7e3c",
    "eslint": "^10.15.0",
    "eslint-config-stylelint": "^28.0.0",
    "lint-staged": "^17.6.2",
    "mdast-util-to-string": "^4.0.0",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.10.1",
    "remark": "^15.0.1",
    "remark-cli": "^12.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-github-admonitions-to-directives": "^2.1.0",
    "stylelint": "https://github.com/stylelint/stylelint/tarball/18.1.0",
    "stylelint-config-alphabetical-order": "^3.0.0",
    "stylelint-config-modern": "^2.0.1",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^7.0.2",
    "unist-util-visit": "^5.2.0",
    "vfile": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26"
    },
    "packageManager": {
      "name": "npm"
    }
  }
}
